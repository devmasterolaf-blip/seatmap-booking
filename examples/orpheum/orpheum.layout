# Seat map of a small two-level theatre.
#
#   row LABEL  GROUP [GROUP...] | GROUP ...
#
# A group is FROM-TO:CATEGORY or NUMBER:CATEGORY; "+acc" marks accessible seats
# and "|" is an aisle that breaks adjacency.

venue "Orpheum Theatre"

category PREM "Premium"
category STD  "Standard"
category BALC "Balcony"

section ORCH "Orchestra"
  row A  1-3:STD | 4-11:PREM | 12-14:STD
  row B  1-3:STD | 4-11:PREM | 12-14:STD
  row C  1-3:STD | 4-11:PREM | 12-14:STD
  row D  1-2:STD+acc 3:STD | 4-11:STD | 12:STD 13-14:STD+acc

section BALC "Balcony"
  row A  1-10:BALC
  row B  1-10:BALC
  row C  1-12:BALC
